# Applies only to the non-secure board targets with the network core update enabled.
configdefault MCUBOOT_USE_ALL_AVAILABLE_RAM
	default y if MCUBOOT_NRF53_MULTI_IMAGE_UPDATE

source "share/sysbuild/Kconfig"
