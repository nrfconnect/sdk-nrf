source "${ZEPHYR_NRF_MODULE_DIR}/samples/wifi/Kconfig.sysbuild.nrf70"

# nRF91 Series devices only support Wi-Fi through an nRF70 Series shield in scan-only mode.
choice WIFI_NRF70_OPER_MODES
	default WIFI_NRF70_SCAN_ONLY if BOARD_NRF9151DK_NRF9151_NS || \
		BOARD_NRF9160DK_NRF9160_NS || BOARD_NRF9161DK_NRF9161_NS || \
		BOARD_THINGY91X_NRF9151_NS
endchoice

source "share/sysbuild/Kconfig"
