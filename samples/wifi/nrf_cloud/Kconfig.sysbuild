config WIFI_NRF70
	default y if BOARD_NRF7002DK_NRF5340_CPUAPP_NS || \
		BOARD_NRF54LM20DK_NRF54LM20A_CPUAPP_NS || \
		BOARD_NRF54LM20DK_NRF54LM20B_CPUAPP_NS

# MCUBoot is not fully supported on nRF7120/ns yet
choice BOOTLOADER
	default BOOTLOADER_MCUBOOT if !BOARD_NRF7120DK_NRF7120_CPUAPP_NS
endchoice

source "share/sysbuild/Kconfig"
