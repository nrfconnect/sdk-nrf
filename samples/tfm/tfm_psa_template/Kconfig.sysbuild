config SAMPLE_PROVISIONING_IMAGE
	bool "Build the TF-M provisioning image as a separate, build-only image"
	depends on SOC_SERIES_NRF54L || SOC_SERIES_NRF71
	default y
	help
	  This is the default way to provision the device for this application.

	  This application does not provision the device itself. When this option is
	  enabled, the provisioning_image sample is built alongside the application as
	  an additional, build-only sysbuild image, so it is not programmed by
	  "west flash" and is not included in any merged hex file. Flash and run it
	  before the application to provision the device (write key material and
	  advance the PSA lifecycle state), for example:

	    west flash --recover --domain provisioning_image

	  Because provisioning is a separate image, this also supports split-production
	  flows where provisioning is performed in a secure environment that is
	  separate from where the application firmware is programmed. The provisioning
	  image is built for the secure board target.

	  Disable this option only if you provision the device in another way, such as
	  a standalone build of the provisioning_image sample.

if SOC_SERIES_NRF54L

# nRF54L signs MCUboot with Ed25519 over the full image rather than its hash
# (Pure mode).
config BOOT_SIGNATURE_TYPE_PURE
	default y

# Generate keyfile.json so that "west flash --recover" provisions the NSIB
# Ed25519 public key to CRACEN KMU. Without this, b0 fails validation (-102).
config SECURE_BOOT_GENERATE_DEFAULT_KMU_KEYFILE
	default y if SECURE_BOOT_APPCORE

# Sample development key. Replace for production use.
config SECURE_BOOT_SIGNING_KEY_FILE
	default "../common/keys/nrf54l_nsib_sample_private.pem"

# Placeholder PSA certificate reference. nRF54L does not have a real
# PSA-certified value yet, and Kconfig.tfm only auto-defaults the string for
# nRF9160 and nRF5340. Replace for production use.
config TFM_PSA_CERTIFICATE_REFERENCE_VALUE
	default "0000000000000-00000"

endif # SOC_SERIES_NRF54L

if BOARD_NRF5340DK_NRF5340_CPUAPP_NS

choice NETCORE
	default NETCORE_EMPTY
endchoice

config SECURE_BOOT_NETCORE
	default y

config NETCORE_APP_UPDATE
	default y

config MCUBOOT_APP_SYNC_UPDATEABLE_IMAGES
	default y

config MCUBOOT_USE_ALL_AVAILABLE_RAM
	default y

endif

source "share/sysbuild/Kconfig"
