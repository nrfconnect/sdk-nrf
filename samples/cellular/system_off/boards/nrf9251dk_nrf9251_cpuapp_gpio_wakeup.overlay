/* Test requires loopback
 * from RXD0 (P1.05) to P0.02
 */

/ {
	/*
	 * Swap button0 with button3
	 * (P0.01 is already used in CI setup for other purposes).
	 */
	buttons {
		compatible = "gpio-keys";

		button0: button_0 {
			gpios = <&gpio0 2 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Button 0";
		};

		button3: button_3 {
			gpios = <&gpio0 1 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Button 3";
		};
	};
};
