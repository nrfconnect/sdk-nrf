source "Kconfig.zephyr"

config NDEF_FILE_STORAGE_RAM
	bool "Keep NDEF file in RAM only (no flash persistence)"
	default y if RISCV_CORE_NORDIC_VPR
	help
	  Nordic VPR cores (for example nRF9251 CPUPPR/CPUFLPR) cannot use the MRAM
	  flash driver (see SOC_FLASH_NRF_MRAM). Enable this to store the NDEF
	  file in RAM, which is lost on reset.

config ZMS
	select CRC
	default y if (SOC_FLASH_NRF_RRAM || SOC_FLASH_NRF_MRAM) && !NDEF_FILE_STORAGE_RAM

config NVS
	default y if !(SOC_FLASH_NRF_RRAM || SOC_FLASH_NRF_MRAM) && !NDEF_FILE_STORAGE_RAM
