menu "Download sample"

config SAMPLE_SECURE_SOCKET
	bool "Use TLS/DTLS"
	default y

if SAMPLE_SECURE_SOCKET

config SAMPLE_SEC_TAG
	int "Security tag"
	default 42

config SAMPLE_PROVISION_CERT
	bool "Provision root CA certificate"
	default y
	help
	  Provision the root CA certificate for the server to the device. This is needed for secure
	  connections.
	  Disable this option to avoid overwriting an existing root CA certificate already stored in
	  the device.

config SAMPLE_CERT_FILE
	string "Certificate file name"
	default "cert/file-example.pem"
	depends on SAMPLE_PROVISION_CERT

config SAMPLE_PROVISION_CLIENT_CERT
	bool "Provision client certificate and key for mutual TLS"
	depends on SAMPLE_PROVISION_CERT
	depends on !MODEM_KEY_MGMT
	help
	  Provision a client certificate and private key in addition to the CA certificate.
	  Required for DTLS/TLS mutual authentication (e.g. with the Californium interop server).
	  Only supported when using the Zephyr TLS credentials store. Not available together with
	  CONFIG_MODEM_KEY_MGMT yet.

config SAMPLE_CLIENT_CERT_FILE
	string "Client certificate file"
	default "cert/cf-client.pem"
	depends on SAMPLE_PROVISION_CLIENT_CERT

config SAMPLE_CLIENT_KEY_FILE
	string "Client private key file"
	default "cert/cf-client-key.pem"
	depends on SAMPLE_PROVISION_CLIENT_CERT

endif

choice SAMPLE_FILE
	prompt "Test file"

config SAMPLE_FILE_HTTP
	bool "HTTP test file"
	depends on !SAMPLE_SECURE_SOCKET
config SAMPLE_FILE_HTTPS
	bool "HTTPS test file"
	depends on SAMPLE_SECURE_SOCKET
config SAMPLE_FILE_CUSTOM
	bool "Custom test file"

endchoice

config SAMPLE_FILE_URL
	string "URL of resource to download" if SAMPLE_FILE_CUSTOM
	default "http://nrfconnectsdk.s3.eu-central-1.amazonaws.com/sample-img-100kb.png" if SAMPLE_FILE_HTTP
	default "https://nrfconnectsdk.s3.eu-central-1.amazonaws.com/sample-img-100kb.png" if SAMPLE_FILE_HTTPS

config SAMPLE_COMPUTE_HASH
	bool "Compute sha256 hash"
	select PSA_CRYPTO
	select PSA_WANT_ALG_SHA_256
	default y

config SAMPLE_COMPARE_HASH
	bool "Compare hash"
	depends on SAMPLE_COMPUTE_HASH
	default y

config SAMPLE_SHA256_HASH
	string "sha256 hash"
	depends on SAMPLE_COMPARE_HASH
	default "344577d739dc0e9f9498c13be2fbc7fb947abd291e9e57db9e9ca4a89ccd5f63" if SAMPLE_FILE_HTTP || SAMPLE_FILE_HTTPS

endmenu

# Default the TLS credentials backend by build type: NS builds use Protected
# Storage, secure-only builds fall back to the volatile backend. nRF91 keeps
# its own NRF_MODEM backend default.
choice TLS_CREDENTIALS_BACKEND
	default TLS_CREDENTIALS_BACKEND_PROTECTED_STORAGE if BUILD_WITH_TFM && !NRF_MODEM_LIB
endchoice

menu "Zephyr Kernel"
source "Kconfig.zephyr"
endmenu
