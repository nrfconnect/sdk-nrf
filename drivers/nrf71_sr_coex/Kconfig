menuconfig NRF71_SR_COEX_DRIVER
	bool "nRF71 Wi-Fi / Short-Range coexistence driver"
	depends on NRF71_WIFI
	help
	  Standalone coexistence coordination driver for the nRF71 combo SoC.

	  The driver configures the on-chip Coexistence Controller (COEXC),
	  forwards CD2CM commands to the Coexistence Manager over the Wi-Fi FMAC
	  control path, and coordinates with the Wi-Fi and Short-Range drivers.

	  The CD<->CM messaging is carried over the Wi-Fi host<->RPU path, so this
	  depends on the nRF71 Wi-Fi driver (NRF71_WIFI). The Coexistence Manager
	  is configured every time Wi-Fi comes up.

if NRF71_SR_COEX_DRIVER

config NRF71_SR_COEX_DRIVER_INIT_PRIORITY
	int "Coexistence driver init priority"
	default 90
	help
	  Initialisation priority of the coexistence driver within the
	  APPLICATION init level. The driver learns the Wi-Fi state through the
	  Wi-Fi driver's state notifier, which replays the current state on
	  registration, so the order against the Wi-Fi driver doesn't matter.

config NRF71_SR_COEX_CM_EVENT_WAIT_MS
	int "CM2CD event wait timeout (ms)"
	range 1 60000
	default 5000
	help
	  Maximum time to wait for a CM2CD completion event after posting a
	  CD2CM command. Increase on slow FPGA targets if commands are timing out.

config NRF71_SR_COEX_CM_RETRY_MAX
	int "Retries of a failed CM configuration"
	range 0 10
	default 3
	help
	  Number of times the CM configuration is repeated after it fails,
	  spaced by NRF71_SR_COEX_CM_RETRY_INTERVAL_MS. Retries stop at the first
	  success or when Wi-Fi goes down. A CM that doesn't answer the first
	  command at all is not retried.

config NRF71_SR_COEX_CM_RETRY_INTERVAL_MS
	int "Delay between CM configuration retries (ms)"
	range 100 60000
	default 1000

config NRF71_SR_COEX_WQ_STACK_SIZE
	int "Stack size of the coexistence work queue"
	default 1536
	help
	  The work queue runs the CD2CM/CM2CD transactions that configure the
	  Coexistence Manager.

config NRF71_SR_COEX_WQ_PRIORITY
	int "Priority of the coexistence work queue"
	default 10

config NRF71_SR_COEX_WAIT_FOR_APP_INIT
	bool "Configure the CM only after the application configuration"
	help
	  Don't configure the Coexistence Manager until the application has
	  called nrf71_sr_coex_init(), so the built-in defaults are never
	  applied first. Without it, the defaults are applied as soon as Wi-Fi
	  is up and replaced once the application configuration arrives.

menuconfig NRF71_SR_COEX_BLE_CHAN_MAP
	bool "Keep BLE off the Wi-Fi channel"
	depends on BT_CENTRAL || BT_BROADCASTER
	help
	  While the Wi-Fi station is connected on 2.4 GHz, mark the BLE data
	  channels under the Wi-Fi channel as bad through bt_le_set_chan_map(),
	  and restore the default map on disconnect and Wi-Fi down.

	  With this enabled the coexistence driver owns the BLE host channel
	  classification and overwrites any map the application sets. Leave it
	  disabled if the application manages the channel map itself.

if NRF71_SR_COEX_BLE_CHAN_MAP

config NRF71_SR_COEX_BLE_GUARD_BAND_MHZ
	int "Guard band either side of the Wi-Fi channel (MHz)"
	range 0 3
	default 3

config NRF71_SR_COEX_BLE_WORKQ_STACK_SIZE
	int "Stack size of the BLE channel map work queue"
	range 1024 8192
	default 2048
	help
	  bt_le_set_chan_map() ends in a blocking HCI command, so the driver
	  applies BLE channel maps from its own work queue rather than from the
	  Wi-Fi driver's context or the system work queue.

config NRF71_SR_COEX_BLE_CHAN_MAP_RETRIES
	int "Retries of a rejected BLE channel map"
	range 0 10
	default 1
	help
	  bt_le_set_chan_map() fails, for example, when the Bluetooth stack is
	  not enabled yet at the time Wi-Fi connects. When the call fails the
	  driver repeats it this many times,
	  NRF71_SR_COEX_BLE_CHAN_MAP_RETRY_DELAY_MS apart, unless a newer map has
	  been queued. Set to 0 to disable the retries.

config NRF71_SR_COEX_BLE_CHAN_MAP_RETRY_DELAY_MS
	int "Delay between BLE channel map retries (ms)"
	range 1000 60000
	default 2000
	help
	  The lower limit is the minimum interval the Bluetooth host requires
	  between two channel map updates.

endif # NRF71_SR_COEX_BLE_CHAN_MAP

config NRF71_SR_COEX_SHELL
	bool "Coexistence driver shell"
	depends on SHELL
	help
	  Shell commands to show the Coexistence Manager configuration state
	  and to read its statistics.

module = NRF71_SR_COEX_DRIVER
module-str = Log level for the nRF71 SR coexistence driver
source "subsys/logging/Kconfig.template.log_config"

endif # NRF71_SR_COEX_DRIVER
