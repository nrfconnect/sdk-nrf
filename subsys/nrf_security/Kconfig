config PSA_CRYPTO
	default y if DT_HAS_ZEPHYR_PSA_CRYPTO_RNG_ENABLED \
		&& !IS_BOOTLOADER_IMG && GEN_ISR_TABLES

choice PSA_CRYPTO_PROVIDER
	default PSA_CRYPTO_PROVIDER_SSF if HAS_IRONSIDE_SE_CALL
	default PSA_CRYPTO_PROVIDER_CUSTOM if SOC_FAMILY_NORDIC_NRF && ARM

config PSA_CRYPTO_PROVIDER_SSF
	bool "SDFW Service Framework (SSF)"
	depends on HAS_IRONSIDE_SE_CALL

endchoice # PSA_CRYPTO_PROVIDER

config PSA_CRYPTO_PROVIDER_CUSTOM
	depends on !BUILD_WITH_TFM
	select MBEDTLS_PSA_CRYPTO_C

menu "nRF Security"

config NRF_SECURITY
	def_bool y
	depends on PSA_CRYPTO_PROVIDER_CUSTOM || BUILD_WITH_TFM || PSA_CRYPTO_PROVIDER_SSF
	depends on SOC_FAMILY_NORDIC_NRF && ARM

# Include Nordic-only PSA configurations
rsource "Kconfig.psa.nordic"

if NRF_SECURITY

# Include TLS/DTLS and x509 configurations
rsource "Kconfig.tls"

# Include TF-PSA-Crypto configurations
rsource "Kconfig.tf-psa-crypto"

# Include PSA Crypto configurations
rsource "Kconfig.psa"

# Include legacy Mbed TLS configurations
rsource "Kconfig.tf-psa-crypto.deprecated"

endif # NRF_SECURITY

endmenu # nRF Security
