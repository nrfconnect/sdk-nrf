menuconfig PLATFORM_METRICS
	bool "Subsystem to monitor platform operating conditions"
	help
	  Enable monitoring of platform operating conditions (battery
	  voltage, die temperature) that other subsystems can use to
	  trigger recalibration, reconfiguration, or other adaptive
	  behavior. Each enabled channel collects live data through its
	  own work item.

if PLATFORM_METRICS

menuconfig PLATFORM_METRICS_DIE_TEMP_MONITOR
	bool "Monitor die temperature"
	select SENSOR
	select SENSOR_ASYNC_API
	help
	  Reads via the Zephyr sensor RTIO API from the device pointed to by
	  the `nordic,platform-metrics-die-temp-sensor` devicetree chosen
	  node. Falls back to the SoC's own die temperature sensor
	  (nodelabel `temp`) when no chosen override is present, so this
	  works out of the box on the DK. Boards with their own ambient
	  temperature sensor can override the chosen node instead of
	  touching this driver.

if PLATFORM_METRICS_DIE_TEMP_MONITOR

config PLATFORM_METRICS_DIE_TEMP_MONITOR_INTERVAL_MS
	int "Die temperature measurement interval (ms)"
	default 10000
	help
	  Interval between die temperature measurements in milliseconds.

endif # PLATFORM_METRICS_DIE_TEMP_MONITOR

config PLATFORM_METRICS_BATTERY_VOLTAGE_MONITOR
	bool "Monitor battery voltage"

config PLATFORM_METRICS_LOG_LEVEL
	int "Logging level in the platform metrics monitor"
	default LOG_DEFAULT_LEVEL
	depends on LOG
	help
	  Sets the logging level for the platform metrics monitor.

config PLATFORM_METRICS_DIE_TEMP_DEFAULT_VALUE
	int "Die temperature default value (centi-degC)"
	default 2500
	help
	  Default value when PLATFORM_METRICS_DIE_TEMP_MONITOR=n. 2500 = 25.00 C.

config PLATFORM_METRICS_BATTERY_VOLTAGE_DEFAULT_VALUE
	int "Battery voltage default value (mV)"
	default 3300
	help
	  Default value when PLATFORM_METRICS_BATTERY_VOLTAGE_MONITOR=n. 3300 = 3.3 V.

config PLATFORM_METRICS_SNAPSHOT_INTERVAL_MS
	int "Snapshot interval (ms)"
	default 10000
	help
	  How often a snapshot is captured from every
	  enabled channel.

endif # PLATFORM_METRICS
