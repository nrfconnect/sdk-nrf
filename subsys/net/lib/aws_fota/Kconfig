menuconfig AWS_FOTA
	bool "AWS Jobs FOTA library"
	select AWS_JOBS
	select CJSON_LIB
	select HTTP_PARSER_URL
	depends on FOTA_DOWNLOAD
	depends on !BOARD_QEMU_X86
	default y if AWS_IOT

if AWS_FOTA

config AWS_FOTA_PAYLOAD_SIZE
	int "MQTT payload reception buffer size for AWS IoT Jobs messages"
	default 4096
	help
	  A job message that does not fit in this buffer is dropped and the job is failed.
	  A job with a presigned URL needs about 2 kB or more, because the URL contains
	  a security token.

config AWS_FOTA_DOWNLOAD_SECURITY_TAG
	int "Security tag to be used for downloads"
	default -1


module=AWS_FOTA
module-str=AWS Jobs FOTA
source "$(ZEPHYR_BASE)/subsys/logging/Kconfig.template.log_config"

endif # AWS_FOTA
