/ {
	aliases {
		dut-flash = &mx25uw63;
		test-gpio = &led0;
		watchdog0 = &wdt010;
		/delete-property/ pwm_led1;
	};

	zephyr,user {
		io-channels = <&adc 0>;
		pwms = <&pwm130 0 PWM_MSEC(10) PWM_POLARITY_NORMAL>,
		       <&pwm131 0 PWM_MSEC(10) PWM_POLARITY_NORMAL>,
		       <&pwm132 0 PWM_MSEC(10) PWM_POLARITY_NORMAL>;
	};
};

&pinctrl {
	i2c131_default_alt: i2c131_default_alt {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 2, 8)>,
				<NRF_PSEL(TWIM_SCL, 1, 2)>;
		};
	};

	i2c131_sleep_alt: i2c131_sleep_alt {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 2, 8)>,
				<NRF_PSEL(TWIM_SCL, 1, 2)>;
			low-power-enable;
		};
	};

	i2c132_default_alt: i2c132_default_alt {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 2, 9)>,
				<NRF_PSEL(TWIM_SCL, 1, 3)>;
			bias-pull-up;
		};
	};

	i2c132_sleep_alt: i2c132_sleep_alt {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 2, 9)>,
				<NRF_PSEL(TWIM_SCL, 1, 3)>;
			low-power-enable;
		};
	};

	pwm130_default_alt: pwm130_default_alt {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 9, 1)>;
		};
	};

	pwm130_sleep_alt: pwm130_sleep_alt {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 9, 1)>;
			low-power-enable;
		};
	};

	pwm131_default_alt: pwm131_default_alt {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 8)>;
		};
	};

	pwm131_sleep_alt: pwm131_sleep_alt {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 8)>;
			low-power-enable;
		};
	};

	pwm132_default_alt: pwm132_default_alt {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 9)>;
		};
	};

	pwm132_sleep_alt: pwm132_sleep_alt {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 9)>;
			low-power-enable;
		};
	};
};

dut_twim: &i2c131 {
	compatible = "nordic,nrf-twim";
	status = "okay";
	pinctrl-0 = <&i2c131_default_alt>;
	pinctrl-1 = <&i2c131_sleep_alt>;
	pinctrl-names = "default", "sleep";
	memory-regions = <&cpuapp_dma_region>;
	zephyr,concat-buf-size = <512>;

	sensor: sensor@54 {
		reg = <0x54>;
	};
};

dut_twis: &i2c132 {
	compatible = "nordic,nrf-twis";
	status = "okay";
	pinctrl-0 = <&i2c132_default_alt>;
	pinctrl-1 = <&i2c132_sleep_alt>;
	pinctrl-names = "default", "sleep";
	memory-regions = <&cpuapp_dma_region>;
};

&gpio6 {
	status = "okay";
	zephyr,pm-device-runtime-auto;
};

&exmif {
	status = "okay";
	zephyr,pm-device-runtime-auto;
};

&mx25uw63 {
	status = "okay";
};

&adc {
	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 10)>;
		zephyr,input-positive = <NRF_SAADC_AIN0>; /* P1.00 */
		zephyr,resolution = <10>;
	};
};

&timer130 {
	status = "okay";
};

&timer131 {
	status = "okay";
};

&timer132 {
	status = "okay";
};

&timer133 {
	status = "okay";
};

&timer134 {
	status = "okay";
};

&timer135 {
	status = "okay";
};

&timer136 {
	status = "okay";
};

&timer137 {
	status = "okay";
};

&pwm130 {
	status = "okay";
	pinctrl-0 = <&pwm130_default_alt>;
	pinctrl-1 = <&pwm130_sleep_alt>;
	pinctrl-names = "default", "sleep";
	memory-regions = <&cpuapp_dma_region>;
};

&pwm131 {
	status = "okay";
	pinctrl-0 = <&pwm131_default_alt>;
	pinctrl-1 = <&pwm131_sleep_alt>;
	pinctrl-names = "default", "sleep";
	memory-regions = <&cpuapp_dma_region>;
};

&pwm132 {
	status = "okay";
	pinctrl-0 = <&pwm132_default_alt>;
	pinctrl-1 = <&pwm132_sleep_alt>;
	pinctrl-names = "default", "sleep";
	memory-regions = <&cpuapp_dma_region>;
};

temp_sensor: &temp_nrfs {
	status = "okay";
};

&gpio9 {
	status = "okay";
};

&wdt010 {
	status = "okay";
};

&zephyr_udc0 {
	cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};
