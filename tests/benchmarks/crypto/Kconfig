config CRYPTO_BENCHMARKS_PSA_SIGNATURE
	bool "Enable all PSA signature tests"
	default y
	select PSA_CRYPTO
	select PSA_WANT_ALG_ECDSA
	select PSA_WANT_ALG_PURE_EDDSA
	select PSA_WANT_ALG_RSA_PKCS1V15_SIGN
	select PSA_WANT_ALG_RSA_PSS
	select PSA_WANT_ALG_ML_DSA
	# Only the public key type: Cracen has no ML-DSA key pair support at all,
	# so the suite imports a known-answer public key and verifies with it.
	select PSA_WANT_KEY_TYPE_ML_DSA_PUBLIC_KEY
	select PSA_WANT_ML_DSA_KEY_SIZE_65
	# Cracen builds ML-DSA out of these.
	select PSA_WANT_ALG_SHAKE128
	select PSA_WANT_ALG_SHA_1
	select PSA_WANT_ALG_SHA_224
	select PSA_WANT_ALG_SHA_256
	select PSA_WANT_ALG_SHA_384
	select PSA_WANT_ALG_SHA_512
	select PSA_WANT_ALG_SHAKE256
	select PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_GENERATE
	select PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_GENERATE
	select PSA_WANT_ECC_BRAINPOOL_P_R1_256
	select PSA_WANT_ECC_BRAINPOOL_P_R1_384
	select PSA_WANT_ECC_BRAINPOOL_P_R1_512
	select PSA_WANT_ECC_SECP_K1_256
	select PSA_WANT_ECC_SECP_R1_224
	select PSA_WANT_ECC_SECP_R1_256
	select PSA_WANT_ECC_SECP_R1_384
	select PSA_WANT_ECC_SECP_R1_521
	select PSA_WANT_ECC_TWISTED_EDWARDS_255
	select PSA_WANT_RSA_KEY_SIZE_4096
	select PSA_WANT_RSA_KEY_SIZE_2048

config CRYPTO_BENCHMARKS_PSA_ASYMMETRIC_ENCRYPTION
	bool "Enable all PSA asymmetric encryption tests"
	default y
	select PSA_CRYPTO
	select PSA_WANT_ALG_RSA_OAEP
	select PSA_WANT_ALG_RSA_PKCS1V15_CRYPT
	select PSA_WANT_ALG_SHA_256
	select PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_GENERATE
	select PSA_WANT_RSA_KEY_SIZE_2048

config CRYPTO_BENCHMARKS_PSA_PAKE
	bool "Enable all PSA PAKE tests"
	default y
	select PSA_CRYPTO
	# EC J-PAKE, the same set as samples/crypto/ecjpake.
	select PSA_WANT_ALG_JPAKE
	select PSA_WANT_ALG_TLS12_ECJPAKE_TO_PMS
	select PSA_WANT_ALG_SHA_256
	select PSA_WANT_KEY_TYPE_PASSWORD
	select PSA_WANT_KEY_TYPE_DERIVE
	select PSA_WANT_KEY_TYPE_ECC_PUBLIC_KEY
	select PSA_WANT_ECC_SECP_R1_256
	# SPAKE2+, the same set as samples/crypto/spake2p. Both sides import a
	# half of a registration record, so the key pair and the public key type
	# are both needed, and HKDF turns the agreed secret into bytes.
	select PSA_WANT_ALG_SPAKE2P_HMAC
	select PSA_WANT_KEY_TYPE_SPAKE2P_KEY_PAIR_IMPORT
	select PSA_WANT_KEY_TYPE_SPAKE2P_PUBLIC_KEY
	select PSA_WANT_ALG_HKDF
	select PSA_WANT_ALG_HMAC
	# SRP-6. Cracen's implementation is hardwired to SHA-512 over the
	# 3072-bit MODP group, so SHA-512 is not optional here. The client
	# derives its private key with the SRP password hash rather than
	# importing one, and the server imports the verifier as a public key.
	select PSA_WANT_ALG_SRP_6
	select PSA_WANT_ALG_SRP_PASSWORD_HASH
	select PSA_WANT_ALG_SHA_512
	select PSA_WANT_KEY_TYPE_SRP_KEY_PAIR_DERIVE
	select PSA_WANT_KEY_TYPE_SRP_PUBLIC_KEY

config CRYPTO_BENCHMARKS_PSA_KEY_WRAP
	bool "Enable all PSA key wrap tests"
	default y
	select PSA_CRYPTO
	select PSA_WANT_ALG_AES_KW
	select PSA_WANT_ALG_AES_KWP
	select PSA_WANT_ALG_ECB_NO_PADDING
	select PSA_WANT_KEY_TYPE_AES

config CRYPTO_BENCHMARKS_PSA_RNG
	bool "Enable all PSA RNG tests"
	default y
	select PSA_CRYPTO
	select PSA_WANT_GENERATE_RANDOM

endmenu

source "Kconfig.zephyr"
