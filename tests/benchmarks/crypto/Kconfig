menu "Crypto benchmarks"

choice CRYPTO_BENCHMARKS_OUTPUT_FORMAT
	prompt "Format of the operation summary"
	default CRYPTO_BENCHMARKS_OUTPUT_TEXT

config CRYPTO_BENCHMARKS_OUTPUT_TEXT
	bool "Human-readable table"
	help
	  One log line per operation, aligned into a table.

config CRYPTO_BENCHMARKS_OUTPUT_JSON
	bool "JSON, for machine consumption"
	help
	  One JSON document, printed between the markers
	  ---CRYPTO-DEMO-JSON-BEGIN--- and ---CRYPTO-DEMO-JSON-END--- so that it
	  can be cut out of a serial capture that also holds log output. Every
	  operation carries the name of the src/suites folder it came from, so
	  that a consumer can group the results by cryptographic family.

	  The document is printed with printk() rather than logged, because the
	  log prefix would leave it unparsable.

endchoice

config CRYPTO_BENCHMARKS_OP_STACK_SIZE
	int "Stack size of the operation threads"
	default 32768
	help
	  Size of the single stack that every operation thread reuses. The
	  operations run one at a time, so this is sized for the most demanding
	  one rather than for the sum of them.

config CRYPTO_BENCHMARKS_OP_TIMEOUT_MS
	int "Time to wait for an operation to finish, in milliseconds"
	default 30000
	help
	  An operation thread does not log, so one that faults or wedges cannot
	  report it. If it has not finished within this time the runner records
	  it as failed and carries on.

config CRYPTO_BENCHMARKS_PSA_CIPHER
	bool "Enable all PSA cipher tests"
	default y
	select PSA_CRYPTO
	select PSA_WANT_ALG_CBC_NO_PADDING
	select PSA_WANT_ALG_CBC_PKCS7
	select PSA_WANT_ALG_CTR
	select PSA_WANT_ALG_ECB_NO_PADDING
	select PSA_WANT_ALG_STREAM_CIPHER
	select PSA_WANT_KEY_TYPE_AES
	select PSA_WANT_KEY_TYPE_CHACHA20

