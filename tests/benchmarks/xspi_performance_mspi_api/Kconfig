source "Kconfig.zephyr"

config TEST_BENCHMARK_SCK_DELAY
	bool "Measure SCK delay"
	default y
	select NRFX_GPPI
	select NRFX_GPIOTE
	help
	  Enables tests which measure the delay between triggering the transfer and
	  detecting clock signal on the SCK line. This requires a physical loopback
	  between the MSPI SCK pin and a GPIO input pin used by the tests.
