source "Kconfig.zephyr"

config TEST_FIXED_OPERATION_SIZE
	bool "Run test for fixed flash operation size"

config TEST_FLASH_OPERATION_SIZE
	int "Flash operation size for fixed size mode"
	default 65536

config TEST_DATA_VERIFICATION
	bool "Verify flash data content after each operation"
	default y
	help
	  When enabled, the test reads back the flash region touched by each
	  erase/write/read operation and checks its content against the
	  expected pattern (erased value after erase, test pattern after
	  write/read). Verification failures are reported but do not affect
	  the measured throughput, which is still based purely on the timed
	  operation itself.
