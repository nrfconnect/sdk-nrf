choice NRF_AUDIO_SW_CODEC_DEFAULT
	default NRF_AUDIO_SW_CODEC_G722

config NRF_AUDIO_SW_CODEC_G722
	bool "g722"

endchoice

choice NRF_AUDIO_SYSTEM_SAMPLE_RATE
	default NRF_AUDIO_SAMPLE_RATE_48000_HZ
endchoice

config NRF_AUDIO_SAMPLE_RATE_HZ
	default 48000

config NRF_AUDIO_BIT_DEPTH_BITS
	default 16

config NRF_AUDIO_BIT_DEPTH_OCTETS
	default 2

config NRF_AUDIO_FRAME_DURATION_US
	default 10000

config NRF_AUDIO_ENCODE_CHANNELS_MAX
	default 2

config NRF_AUDIO_DECODE_CHANNELS_MAX
	default 2

config NRF_AUDIO_INPUT_CHANNELS
	default 2

config NRF_AUDIO_OUTPUT_CHANNELS
	default 2

config NRF_AUDIO_SW_CODEC_SELECT_LOG_LEVEL
	default 3

config NRF_AUDIO_MONO_TO_ALL_RECEIVERS
	default n

source "$(ZEPHYR_NRF_MODULE_DIR)/applications/nrf_audio/src/audio/Kconfig"
source "Kconfig.zephyr"
