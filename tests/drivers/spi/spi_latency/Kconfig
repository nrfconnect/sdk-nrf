config TEST_MEASUREMENT_REPEATS
	int "Number of latency measurements repeats"
	default 100

config TEST_MAX_BUFFER_SIZE
	int "Maximum SPI transceive buffer size allocated and tested"
	default 512 if SOC_NRF9251_CPUPPR
	default 512 if SOC_NRF54H20_CPUPPR
	default 2000

config TEST_SPI_LATENCY_BASE_OVERHEAD_US
	int "Base overhead time for SPI latency measurement"
	default 130 if SOC_NRF9251_CPUPPR || SOC_NRF54H20_CPUPPR
	default 90 if SOC_SERIES_NRF52
	default 80 if SOC_NRF5340_CPUAPP
	default 65 if SOC_NRF54LS05B_CPUAPP || SOC_NRF54LS05A_CPUAPP
	default 55

config TEST_SPI_LATENCY_PER_BYTE_OVERHEAD_US
	int "Overhead time per byte for SPI latency measurement"
	default 2 if RISCV_CORE_NORDIC_VPR && XIP
	default 1 if HAS_NORDIC_DMM
	default 0

source "Kconfig.zephyr"
