/* Test requires GPIO loopback between P2.03 and P2.09. */

/ {
	resources {
		compatible = "test-hpf-gpio";
		out-gpios = <&hpf_gpio2 3 GPIO_ACTIVE_HIGH>;
		in-gpios = <&gpio2 9 GPIO_ACTIVE_HIGH>;
	};
};

/* Route the output pin to the FLPR VPR. */
&pinctrl {
	flpr_vio_default: flpr_vio_default {
		group1 {
			psels = <NRF_PSEL(VPR_VIO, 2, 3)>;
		};
	};
};

&cpuflpr_vpr {
	pinctrl-0 = <&flpr_vio_default>;
	pinctrl-names = "default";
};

&gpiote130 {
	status = "okay";
};

&gpio2 {
	status = "okay";
};
