#include "nrf54l.overlay"

/*
 * Test requires loopback between P1.03 and P1.04
 */

/ {
	zephyr,user {
		test-gpios = <&gpio1 3 GPIO_ACTIVE_HIGH>;
		test-saadc-input = <NRF_SAADC_AIN6>; /* P1.04 */
	};
};
