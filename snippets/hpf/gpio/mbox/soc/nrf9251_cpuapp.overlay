#include "../../hpf-gpio-app.overlay"

/* Reuse cpuapp-cpuflpr shared-memory regions and disable cache as mbox does not flush. */
sram_tx: &cpuapp_cpuflpr_ipc_shm {
	compatible = "zephyr,memory-region", "mmio-sram";
	zephyr,memory-region = "IPC_SHM_TX";
	zephyr,memory-attr = <DT_MEM_ARM(ATTR_MPU_RAM_NOCACHE)>;
	#memory-region-cells = <0>;
};

sram_rx: &cpuflpr_cpuapp_ipc_shm {
	compatible = "zephyr,memory-region", "mmio-sram";
	zephyr,memory-region = "IPC_SHM_RX";
	zephyr,memory-attr = <DT_MEM_ARM(ATTR_MPU_RAM_NOCACHE)>;
	#memory-region-cells = <0>;
};

/ {
	mbox_consumer {
		compatible = "vnd,mbox-consumer";
		mboxes = <&cpuapp_bellboard 14>, <&cpuflpr_vevif 16>;
		mbox-names = "rx", "tx";
	};
};

&pinctrl {
	/* Route only the LED pin (P2.2, VIO index 6) for now. */
	vpr_flpr_vio_default: vpr_flpr_vio_default {
		group1 {
			psels = <NRF_PSEL(VPR_VIO, 2, 2)>; /* P2.2 -> VIO 6 (LED0) */
		};
	};
};

&cpuflpr_vpr {
	pinctrl-0 = <&vpr_flpr_vio_default>;
	pinctrl-names = "default";
};

&cpuflpr_vevif {
	status = "okay";
};

&hpf_gpio {
	status = "okay";
	ngpios = <10>;
	port = <2>;
};

&gpio2 {
	status = "disabled";
};

/* Free pin P2.2. */
&pwm130 {
	status = "disabled";
};
