/ {
	chosen {
		zephyr,console = &uart132;
	};
};

&pinctrl {
	uart132_default: uart132_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 2, 5)>;
		};

		group3 {
			psels = <NRF_PSEL(UART_RX, 2, 4)>;
			bias-pull-up;
		};
	};

	uart132_sleep: uart132_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 2, 5)>,
				<NRF_PSEL(UART_RX, 2, 4)>;
			low-power-enable;
		};
	};
};

&uart132 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart132_default>;
	pinctrl-1 = <&uart132_sleep>;
	pinctrl-names = "default", "sleep";
	memory-regions = <&cpuapp_dma_region>;
};

&cpuapp_dma_region {
	status = "okay";
};
