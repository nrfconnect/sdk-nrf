config DESKTOP_ADV_PROV_UUID16_ALL
	bool "UUID16 advertising provider"
	depends on BT_ADV_PROV
	depends on (DESKTOP_HIDS_ENABLE || DESKTOP_BAS_ENABLE)
	help
	  Adds all UUID16 to the advertising payload if used Bluetooth local
	  identity has no bond.

if DESKTOP_ADV_PROV_UUID16_ALL
config DESKTOP_ADV_PROV_UUID16_ALL_SD
	bool "Move UUID16 to scan response"
	default y
	help
	  Adds all UUID16 to scan response data. If this option is
	  disabled, the UUID16 is included in the advertising data.
endif
