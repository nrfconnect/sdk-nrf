rsource "Kconfig.defaults"

menu "Bluetooth"

rsource "bt_management/Kconfig"

#----------------------------------------------------------------------------#
menu "Bluetooth audio"

if NRF_AUDIO_TRANSPORT_BIS

rsource "bt_stream/broadcast/Kconfig"

endif # NRF_AUDIO_TRANSPORT_BIS

if NRF_AUDIO_TRANSPORT_CIS

rsource "bt_stream/unicast/Kconfig"

endif # NRF_AUDIO_TRANSPORT_CIS

rsource "bt_stream/bt_le_audio_tx/Kconfig"

config NRF_AUDIO_PACKING_INTERLEAVED
	bool "Interleaved packing"
	help
	  ISO channels can either be interleaved or sequentially packed; sequential is the default one.

config NRF_AUDIO_CONCURRENT_RX_STREAMS_MAX
	int "Max number of concurrent streams"
	range 1 32
	default 1
	help
	  The maximum number of concurrent streams supported in the RX direction.
	  This is the maximum number of streams that can be active at the same time.

config NRF_AUDIO_CONCURRENT_TX_STREAMS_MAX
	int "Max number of concurrent streams"
	range 1 32
	default 1
	help
	  The maximum number of concurrent streams supported in the TX direction.
	  This is the maximum number of streams that can be active at the same time.

config NRF_AUDIO_PREF_SINK_SAMPLE_RATE_VALUE
	hex
	default 0x03 if NRF_AUDIO_PREF_SINK_SAMPLE_RATE_16KHZ
	default 0x05 if NRF_AUDIO_PREF_SINK_SAMPLE_RATE_24KHZ
	default 0x08 if NRF_AUDIO_PREF_SINK_SAMPLE_RATE_48KHZ

choice NRF_AUDIO_PREF_SINK_SAMPLE_RATE
	prompt "Preferred BT audio sink sample rate"
	default NRF_AUDIO_PREF_SINK_SAMPLE_RATE_16KHZ if NRF_AUDIO_BAP_BROADCAST_16_2_1
	default NRF_AUDIO_PREF_SINK_SAMPLE_RATE_16KHZ if NRF_AUDIO_BAP_BROADCAST_16_2_2
	default NRF_AUDIO_PREF_SINK_SAMPLE_RATE_16KHZ if NRF_AUDIO_BAP_UNICAST_16_2_1
	default NRF_AUDIO_PREF_SINK_SAMPLE_RATE_24KHZ if NRF_AUDIO_STREAM_BIDIRECTIONAL
	default NRF_AUDIO_PREF_SINK_SAMPLE_RATE_24KHZ if NRF_AUDIO_BAP_BROADCAST_24_2_1
	default NRF_AUDIO_PREF_SINK_SAMPLE_RATE_24KHZ if NRF_AUDIO_BAP_BROADCAST_24_2_2
	default NRF_AUDIO_PREF_SINK_SAMPLE_RATE_24KHZ if NRF_AUDIO_BAP_UNICAST_24_2_1
	default NRF_AUDIO_PREF_SINK_SAMPLE_RATE_48KHZ
	help
	  Select the preferred sample rate to stream if there are more than one to choose from.
	  Only valid when used by unicast_client if CONFIG_SAMPLE_RATE_CONVERTER=y and
	  CONFIG_NRF_AUDIO_SAMPLE_RATE_48000_HZ=y, meaning 16, 24, and 48kHz are supported.

config NRF_AUDIO_PREF_SINK_SAMPLE_RATE_48KHZ
	bool "48 kHz"
	help
	  Select 48000 Hz as the preferred sink sample rate.

config NRF_AUDIO_PREF_SINK_SAMPLE_RATE_24KHZ
	bool "24 kHz"
	help
	  Select 24000 Hz as the preferred sink sample rate.

config NRF_AUDIO_PREF_SINK_SAMPLE_RATE_16KHZ
	bool "16 kHz"
	help
	  Select 16000 Hz as the preferred sink sample rate.
endchoice

config NRF_AUDIO_PREF_SOURCE_SAMPLE_RATE_VALUE
	hex
	default 0x03 if NRF_AUDIO_PREF_SOURCE_SAMPLE_RATE_16KHZ
	default 0x05 if NRF_AUDIO_PREF_SOURCE_SAMPLE_RATE_24KHZ
	default 0x08 if NRF_AUDIO_PREF_SOURCE_SAMPLE_RATE_48KHZ

choice NRF_AUDIO_PREF_SOURCE_SAMPLE_RATE
	prompt "Preferred BT audio source sample rate"
	default NRF_AUDIO_PREF_SOURCE_SAMPLE_RATE_16KHZ if NRF_AUDIO_BAP_UNICAST_16_2_1
	default NRF_AUDIO_PREF_SOURCE_SAMPLE_RATE_24KHZ if NRF_AUDIO_STREAM_BIDIRECTIONAL
	default NRF_AUDIO_PREF_SOURCE_SAMPLE_RATE_24KHZ if NRF_AUDIO_BAP_UNICAST_24_2_1
	default NRF_AUDIO_PREF_SOURCE_SAMPLE_RATE_48KHZ
	help
	  Select the preferred sample rate to stream if there are more than one to choose from.
	  Only valid when used by unicast_client if CONFIG_SAMPLE_RATE_CONVERTER=y and
	  CONFIG_NRF_AUDIO_SAMPLE_RATE_48000_HZ=y, meaning 16, 24, and 48kHz are supported.

config NRF_AUDIO_PREF_SOURCE_SAMPLE_RATE_48KHZ
	bool "48 kHz"
	help
	  Select 48000 Hz as the preferred source sample rate.

config NRF_AUDIO_PREF_SOURCE_SAMPLE_RATE_24KHZ
	bool "24 kHz"
	help
	  Select 24000 Hz as the preferred source sample rate.

config NRF_AUDIO_PREF_SOURCE_SAMPLE_RATE_16KHZ
	bool "16 kHz"
	help
	  Select 16000 Hz as the preferred source sample rate.
endchoice

#----------------------------------------------------------------------------#
menu "QoS"

config NRF_AUDIO_PRESENTATION_DELAY_US
	int "Presentation delay"
	range NRF_AUDIO_MIN_PRES_DLY_US NRF_AUDIO_MAX_PRES_DLY_US
	default NRF_AUDIO_MIN_PRES_DLY_US
	help
	  The audio source/client defined presentation delay if within
	  NRF_AUDIO_MIN_PRES_DLY_US and NRF_AUDIO_MAX_PRES_DLY_US range. This will
	  override the audio receivers presentation delay as long as it
	  is in range of the max and min supported by the audio receivers.
	  If it is outside this range, then it will revert to the closest
	  supported value.

config NRF_AUDIO_MAX_TRANSPORT_LATENCY_MS
	int "Max transport latency"
	range 5 4000
	default 10
	help
	  Max transport latency for the ISO link.

config NRF_AUDIO_RETRANSMITS
	int "Number of re-transmits"
	range 0 30
	default 2
	help
	  Number of re-transmits for the ISO link. 2 re-transmits means a total
	  of 3 packets sent per stream.

endmenu # QoS
endmenu # Bluetooth audio

rsource "bt_rendering_and_capture/Kconfig"
rsource "bt_content_control/Kconfig"

