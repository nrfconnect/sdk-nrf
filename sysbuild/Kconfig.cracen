config SUPPORT_CRACEN
	bool
	default y if SOC_SERIES_NRF54L
	help
	  Hidden symbol indicating if CRACEN is supported on the device.

if SUPPORT_CRACEN

config SUPPORT_CRACEN_MICROCODE
	bool
	default y if SOC_NRF54L15 || SOC_NRF54L10 || SOC_NRF54L05
	help
	  Hidden symbol indicating if CRACEN microcode loading is supported on the device.

config CRACEN_KMU_CUSTOM_LAYOUT
	bool "Use a custom CRACEN KMU slot layout in all images"
	help
	  Apply the KMU slot layout below to every image, so that all images agree on the slots
	  reserved by the CRACEN driver. The layout is stored in the CRACEN_KMU_* Kconfig options
	  of each image. If not enabled, each image uses its own values for these options.

if CRACEN_KMU_CUSTOM_LAYOUT

config CRACEN_KMU_PROVISIONING_SLOT
	int "KMU slot recording that provisioning is in progress"
	range 0 255
	default 186

config CRACEN_KMU_PROT_RAM_INV_SLOT
	int "First KMU slot of the protected RAM invalidation data (2 slots)"
	range 0 254
	default 248

config CRACEN_IKG_SEED_KMU_SLOT
	int "First KMU slot of the CRACEN IKG seed (3 slots)"
	range 0 253
	default 183

config CRACEN_KMU_NS_SLOT_FIRST
	int "First KMU slot the TF-M non-secure agent may access"
	range 0 255
	default 0

config CRACEN_KMU_NS_SLOT_LAST
	int "Last KMU slot the TF-M non-secure agent may access"
	range 0 255
	default 179

endif # CRACEN_KMU_CUSTOM_LAYOUT

if SUPPORT_CRACEN_MICROCODE

menu "CRACEN"

config CRACEN_MICROCODE_LOAD_B0
	bool
	depends on SECURE_BOOT_APPCORE && SECURE_BOOT_SIGNATURE_TYPE_ED25519
	default y
	help
	  Hidden symbol indicating if b0 is using CRACEN.

config CRACEN_MICROCODE_LOAD_MCUBOOT
	bool
	depends on BOOTLOADER_MCUBOOT && BOOT_SIGNATURE_TYPE_ED25519
	default y
	help
	  Hidden symbol indicating if MCUboot is using CRACEN.

config CRACEN_MICROCODE_LOAD_ONCE
	bool "Load CRACEN microcode once only"
	depends on CRACEN_MICROCODE_LOAD_B0 || CRACEN_MICROCODE_LOAD_MCUBOOT
	default y
	help
	  If enabled, will only load microcode for CRACEN in the first system bootable image,
	  which will be either b0 or MCUboot, depending on project configuration.

endmenu

endif # SUPPORT_CRACEN_MICROCODE

endif # SUPPORT_CRACEN
