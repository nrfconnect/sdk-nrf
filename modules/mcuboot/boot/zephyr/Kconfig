# NCS-only MCUboot boot-image options (IronSide SE / PERIPHCONF / MPCCONF).
# Sourced from [mcuboot_dir]/boot/zephyr/Kconfig.
# Sysbuild-facing mirrors live in nrf/sysbuild/Kconfig.mcuboot.

if IRONSIDE_SE_CALL

choice IRONSIDE_SE_CALL_DRIVER
	default IRONSIDE_SE_CALL_MINIMAL
endchoice

endif

config NCS_MCUBOOT_LOAD_PERIPHCONF
	bool "Load new peripheral configuration before jumping to the application"
	depends on HAS_IRONSIDE_SE
	depends on IRONSIDE_SE_CALL_MINIMAL
	help
	  When enabled, MCUboot looks for a TLV pointing to a slot specific list of
	  peripheral configurations (PERIPHCONF) to initialize peripherals with before
	  booting that slot. The actual initialization happens via a IronSide SE IPC call.

if NCS_MCUBOOT_LOAD_PERIPHCONF

config NCS_MCUBOOT_LOAD_PERIPHCONF_MAX_BLOBS
	int "Max PERIPHCONF blobs to load"
	default 8
	help
	  The maximum number of PERIPHCONF blobs loaded by MCUboot for a slot.

endif

config NCS_MCUBOOT_MPCCONF_STATIC_WRITE_PROTECTION
	bool "Write protect partitions using MPCCONF"
	select NRF_MPCCONF_SECTION
	depends on HAS_IRONSIDE_SE
	depends on IRONSIDE_SE_CALL_MINIMAL
	help
	  Remove write permissions from the bootloader partition and all booted images
	  by configuring the global domain Memory Privilege Controllers (MPCs) using the
	  UICR.MPCCONF setting and the MPCCONF service provided by IronSide SE.
	  When this option is enabled, MCUboot will contain static UICR MPCCONF
	  entries which are extracted by the UICR generator image and placed into the
	  mpcconf_partition area. Before booting the application, MCUboot uses the MPCCONF
	  service to update the MPCs to write protect the slot being booted.

if NCS_MCUBOOT_MPCCONF_STATIC_WRITE_PROTECTION

DT_CHOSEN_Z_CODE_PARTITION := zephyr,code-partition

config NCS_MCUBOOT_MPCCONF_STATIC_WRITE_PROTECTION_INITIAL_REGION_SIZE
	hex "Size of the initial write protected region"
	default $(dt_chosen_reg_size_hex,$(DT_CHOSEN_Z_CODE_PARTITION))
	help
	  Size in bytes of the first write protected region, which begins at the start
	  of the application MRAM. It defaults to the size of the code partition region of the
	  bootloader, but can be increased in order to span subsequent partitions, for example
	  to write protect a PERIPHCONF partition and/or MPCCONF partition together with
	  integrity checking the region at boot using the UICR.PROTECTEDMEM feature.

endif

if NCS_MCUBOOT_LOAD_PERIPHCONF || NCS_MCUBOOT_MPCCONF_STATIC_WRITE_PROTECTION

config NCS_MCUBOOT_LOAD_IRONSIDE_SE_CONF_RESET_ON_ERROR
	bool "Reset if loading PERIPHCONF or MPCCONF fails"
	default y
	help
	  Trigger a system reset on failure to load new peripheral configurations
	  via IronSide SE IPC. A failure to load the configuration in most cases means
	  that it was rejected by IronSide SE, either because it contained invalid register values,
	  or different parts of the configuration was in conflict with each other.
	  If this option is disabled, MCUboot will instead loop indefinitely on failure.

endif
